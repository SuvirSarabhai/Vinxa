# Optional: used only when the user enables cloud notes.
OPENAI_API_KEY=

# Development-only paths. Keep models and recordings outside this repository.
VINXA_MODEL_DIR=
VINXA_DATA_DIR=

# Launch-shell options; copying this template does not load it automatically.
VINXA_BACKEND=local
VINXA_SPEECH_MODEL=base.en
VINXA_SPEECH_LANGUAGE=en
# Optional full interpreter/source paths. Leave unset to use this repo's .venv.
# VINXA_SIDECAR_PYTHON=C:\path\to\.venv\Scripts\python.exe
# VINXA_SIDECAR_SOURCE=D:\Python Workspace\Vinxa
# Optional converted model directory; packaged builds discover their bundled model.
# VINXA_SPEECH_MODEL_PATH=C:\path\outside\repo\converted-model
# VINXA_DIAGNOSTICS_DIR=C:\path\outside\repo\vinxa-diagnostics

