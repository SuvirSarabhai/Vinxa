{
  "constants": {
    "sampleRate": 16000,
    "channels": 1,
    "frameSamples": 1600,
    "frameBytes": 3200,
    "sourceIds": {
      "mic": 0,
      "system": 1
    }
  },
  "config": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "const": "config"
      },
      "protocolVersion": {
        "type": "number",
        "const": 1
      },
      "sessionId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "token": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$"
      },
      "sampleRate": {
        "type": "number",
        "const": 16000
      },
      "channels": {
        "type": "number",
        "const": 1
      },
      "encoding": {
        "type": "string",
        "const": "pcm_s16le"
      },
      "frameMs": {
        "type": "number",
        "const": 100
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "language": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          {
            "type": "null"
          }
        ]
      },
      "enabledSources": {
        "minItems": 1,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "mic",
            "system"
          ]
        },
        "uniqueItems": true
      }
    },
    "required": [
      "type",
      "protocolVersion",
      "sessionId",
      "generation",
      "token",
      "sampleRate",
      "channels",
      "encoding",
      "frameMs",
      "model",
      "language",
      "enabledSources"
    ],
    "additionalProperties": false
  },
